# ── Embedding ──────────────────────────────────────────────────────────────
EMBED_BACKEND=siglip2
EMBED_SIGLIP_MODEL_NAME=google/siglip2-so400m-patch14-384
EMBED_DEVICE=cuda
EMBED_BATCH_SIZE=64
EMBED_USE_FP16=true

# ── Frame Extraction ───────────────────────────────────────────────────────
FRAME_MODE=fixed_fps
FRAME_FPS=1.0
FRAME_IMAGE_FORMAT=jpg
FRAME_IMAGE_QUALITY=85
FRAME_NUM_WORKERS=4

# ── OCR ────────────────────────────────────────────────────────────────────
OCR_LANG=vi
OCR_USE_GPU=true
OCR_MIN_CONFIDENCE=0.5
OCR_BGE_MODEL_NAME=BAAI/bge-m3
OCR_BGE_DEVICE=cuda
OCR_BGE_BATCH_SIZE=32

# ── Detection ──────────────────────────────────────────────────────────────
DETECT_MODEL_SIZE=yolo11l.pt
DETECT_DEVICE=cuda
DETECT_CONFIDENCE_THRESHOLD=0.3
DETECT_BATCH_SIZE=16

# ── Milvus ─────────────────────────────────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ── Retrieval ──────────────────────────────────────────────────────────────
RETRIEVAL_CLIP_TOP_K=300
RETRIEVAL_OCR_BM25_TOP_K=50
RETRIEVAL_OCR_EMBED_TOP_K=50
RETRIEVAL_OBJECT_TOP_K=100
RETRIEVAL_TEMPORAL_WINDOW=20
RETRIEVAL_FINAL_TOP_K=100
RETRIEVAL_WEIGHT_CLIP=1.0
RETRIEVAL_WEIGHT_OCR_BM25=0.6
RETRIEVAL_WEIGHT_OCR_EMBED=0.5
RETRIEVAL_WEIGHT_OBJECT=0.4

# ── LLM Query Parser ──────────────────────────────────────────────────────
RETRIEVAL_LLM_PROVIDER=gemini
RETRIEVAL_LLM_MODEL=gemini-2.0-flash
RETRIEVAL_LLM_TEMPERATURE=0.0
RETRIEVAL_GEMINI_API_KEY=your_openai_api_key
# RETRIEVAL_OPENAI_API_KEY=your_openai_api_key_here

# ── Audio (Optional) ───────────────────────────────────────────────────────
AUDIO_ENABLED=false
AUDIO_MODEL_SIZE=large-v3-turbo
AUDIO_LANGUAGE=vi
